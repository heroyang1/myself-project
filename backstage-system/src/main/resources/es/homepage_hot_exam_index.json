{
  "settings": { "number_of_shards": 1, "number_of_replicas": 0 },
  "mappings": {
    "properties": {
      "id": { "type": "long" },
      "title": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } },
      "cover": { "type": "keyword" },
      "description": { "type": "text" },
      "totalScore": { "type": "integer" },
      "passScore": { "type": "integer" },
      "expire": { "type": "integer" },
      "questionCount": { "type": "integer" },
      "collectCount": { "type": "integer" },
      "hotScore": { "type": "double" },
      "tags": { "type": "keyword" },
      "detailUrl": { "type": "keyword" },
      "sortNo": { "type": "integer" },
      "sourceLimit": { "type": "integer" },
      "syncTime": { "type": "date", "format": "yyyy-MM-dd HH:mm:ss||strict_date_optional_time||epoch_millis" }
    }
  }
}
