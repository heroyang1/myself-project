{
  "settings": { "number_of_shards": 1, "number_of_replicas": 0 },
  "mappings": {
    "properties": {
      "activityId": { "type": "long" },
      "itemId": { "type": "long" },
      "goodsId": { "type": "long" },
      "goodsType": { "type": "integer" },
      "goodsName": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } },
      "goodsCover": { "type": "keyword" },
      "originPrice": { "type": "scaled_float", "scaling_factor": 100 },
      "seckillPrice": { "type": "scaled_float", "scaling_factor": 100 },
      "stock": { "type": "integer" },
      "soldCount": { "type": "integer" },
      "limitPerUser": { "type": "integer" },
      "detailUrl": { "type": "keyword" },
      "sortNo": { "type": "integer" },
      "sourceLimit": { "type": "integer" },
      "syncTime": { "type": "date", "format": "yyyy-MM-dd HH:mm:ss||strict_date_optional_time||epoch_millis" }
    }
  }
}
