<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.backstage.system.mapper.contentbg.OshContentBgImageMapper">

    <update id="clearGlobalDefault">
        update osh_content_bg_image
        set is_default = 0,
            update_by = #{operator},
            update_time = now()
        where is_default = 1
          and delete_flag = 0
    </update>
</mapper>
