<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  主观约定 → 机械规则 翻译总表（错误信息即 Prompt）
  经验法则：一条约定在 Code Review 被提过 3 次以上，就应固化成 Linter 规则。

  约定            机械规则                          实现方式（本项目真实落位）
  方法要短        单方法 ≤ 50 行                    Checkstyle MethodLength（本文件）
  文件要短        单文件 ≤ 300 行                   Checkstyle FileLength（本文件）
  日志要规范      禁 System.out/err、printStackTrace   Checkstyle 正则（本文件）+ ArchUnit CodingConventionArchitectureTest
  HTTP 调用统一   禁裸 RestTemplate/OkHttp/HttpURLConnection   ArchUnit CodingConventionArchitectureTest（FreezingArchRule 冻结基线）
  Controller 纯   Controller 不得直接调 Mapper       ArchUnit LayeredArchitectureTest
  构造器注入      禁字段级 @Autowired                故意未启用：RuoYi 存量大量字段注入，详见 docs/architecture/package-structure.md
  不污染全局      禁 public static 非 final 字段     SpotBugs MS_ 规则族（未接入 pom，暂不启用）
  测试充分        行覆盖率 ≥ 80%                     未启用：CI 不强制覆盖率（团队决定）
  锁定工具版本    Maven ≥ 3.6.3、JDK = 1.8           不适用：本项目 CI 用 JDK 17、Maven runner 默认（见 pr-check.yml）

  注：本文件当前是"待接入资产"，需在 pom 挂 maven-checkstyle-plugin（Java 8 兼容用 9.3）后方在构建/CI 生效。
-->
<module name="Checker">
    <property name="severity" value="error"/>

    <module name="FileLength">
        <property name="max" value="300"/>
        <message key="maxLen.file"
                 value="❌ 文件超过 300 行。
✅ FIX: 拆分为更小的类，把辅助方法移至 *Helper 或 infrastructure。
📖 See: docs/ai/05-code-style.md"/>
    </module>

    <module name="TreeWalker">
        <module name="MethodLength">
            <property name="max" value="50"/>
            <property name="countEmpty" value="false"/>
            <message key="maxLen.method"
                     value="❌ 方法超过 50 行。
✅ FIX: 抽取私有方法或将职责下沉到 Service / Domain。
📖 See: docs/ai/05-code-style.md"/>
        </module>

        <module name="RegexpSinglelineJava">
            <property name="format" value="System\.(out|err)\."/>
            <property name="message"
                      value="❌ 禁止 System.out / System.err 直接输出。
✅ FIX: private static final Logger log = LoggerFactory.getLogger(X.class);
📖 See: docs/ai/conventions/logging.md"/>
        </module>

        <module name="RegexpSinglelineJava">
            <property name="format" value="\.printStackTrace\(\)"/>
            <property name="message"
                      value="❌ 禁止 e.printStackTrace()。
✅ FIX: log.error(&quot;context message&quot;, e);
📖 See: docs/ai/conventions/logging.md"/>
        </module>
    </module>
</module>
